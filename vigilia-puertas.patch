+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Vigilia|Door")
+	bool bSwapHingeSide = false;
+
 	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Vigilia|Door")
 	float OpenAngle = 96.f;
 
